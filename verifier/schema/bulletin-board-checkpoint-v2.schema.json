{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mongbas.example/schema/bulletin-board-checkpoint-v2.schema.json",
  "title": "Mongbas Ballot-History Witness Checkpoint v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "witnessID", "witnessPublicKeyDer", "sequence", "previousCheckpointHash", "observedAt", "electionID", "bundleHash", "bulletinBoardRoot", "ballotCount", "publishedAt", "history", "signature"],
  "properties": {
    "schema": { "const": "mongbas-bulletin-board-checkpoint/v2" },
    "witnessID": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
    "witnessPublicKeyDer": { "type": "string", "contentEncoding": "base64" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "previousCheckpointHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] },
    "observedAt": { "type": "string", "format": "date-time" },
    "electionID": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,256}$" },
    "bundleHash": { "$ref": "#/$defs/hash" },
    "bulletinBoardRoot": { "$ref": "#/$defs/hash" },
    "ballotCount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "publishedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "history": { "$ref": "#/$defs/history" },
    "signature": { "type": "string", "contentEncoding": "base64" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "treeAlgorithm", "leafAlgorithm", "contextHash", "treeSize", "rootHash", "previousTreeSize", "previousRootHash", "consistencyPath"],
      "properties": {
        "schema": { "const": "mongbas-ballot-history/v1" },
        "treeAlgorithm": { "const": "mongbas-ballot-history-tree-sha256/v1" },
        "leafAlgorithm": { "const": "mongbas-canonical-ballot-commitment-sha256/v1" },
        "contextHash": { "$ref": "#/$defs/hash" },
        "treeSize": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "rootHash": { "$ref": "#/$defs/hash" },
        "previousTreeSize": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "previousRootHash": { "$ref": "#/$defs/hash" },
        "consistencyPath": { "type": "array", "maxItems": 54, "items": { "$ref": "#/$defs/hash" } }
      }
    }
  }
}
