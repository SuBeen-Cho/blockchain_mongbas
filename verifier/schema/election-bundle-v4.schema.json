{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mongbas.example/schema/election-bundle-v4.schema.json",
  "title": "Mongbas Vector Audit-or-Cast Threshold Election Bundle v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "algorithms", "configuration", "provenance", "publicKey", "trusteePublicShares", "ballots", "bulletinBoard", "aggregateCiphertextVector", "tally", "vectorPartialDecryptions", "vectorBallotReceipts", "vectorAuditDisclosures", "signatures"],
  "properties": {
    "schema": { "const": "mongbas-election-bundle/v4" },
    "algorithms": {
      "type": "object", "additionalProperties": false,
      "required": ["canonicalization", "hash", "signature", "tally"],
      "properties": {
        "canonicalization": { "const": "mongbas-canonical-json-v1" },
        "hash": { "const": "sha-256" },
        "signature": { "const": "ed25519" },
        "tally": { "const": "mongbas-exp-elgamal-vector-threshold-v3" }
      }
    },
    "configuration": { "$ref": "#/$defs/vectorConfiguration" },
    "provenance": { "$ref": "election-bundle-v1.schema.json#/properties/provenance" },
    "publicKey": { "$ref": "election-bundle-v1.schema.json#/$defs/publicKey" },
    "trusteePublicShares": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "election-bundle-v2.schema.json#/$defs/publicShare" } },
    "ballots": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/$defs/vectorBallot" } },
    "bulletinBoard": { "$ref": "election-bundle-v1.schema.json#/properties/bulletinBoard" },
    "aggregateCiphertextVector": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "election-bundle-v1.schema.json#/$defs/ciphertext" } },
    "tally": { "$ref": "#/$defs/vectorTally" },
    "vectorPartialDecryptions": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/vectorPartial" } },
    "vectorBallotReceipts": { "type": "array", "maxItems": 20000, "items": { "$ref": "#/$defs/vectorReceipt" } },
    "vectorAuditDisclosures": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/vectorDisclosure" } },
    "signatures": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/signature" } }
  },
  "$defs": {
    "vectorConfiguration": { "type": "object", "additionalProperties": false, "required": ["electionID", "candidates", "signatureThreshold", "organizations"], "properties": { "electionID": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,256}$" }, "candidates": { "type": "array", "minItems": 2, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }, "signatureThreshold": { "type": "integer", "minimum": 1 }, "organizations": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/organization" } } } },
    "organization": { "type": "object", "additionalProperties": false, "required": ["id", "ed25519PublicKeyDer"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "ed25519PublicKeyDer": { "type": "string", "contentEncoding": "base64" } } },
    "signature": { "type": "object", "additionalProperties": false, "required": ["organizationID", "signature"], "properties": { "organizationID": { "type": "string", "minLength": 1, "maxLength": 128 }, "signature": { "type": "string", "contentEncoding": "base64" } } },
    "vectorTally": { "type": "object", "additionalProperties": false, "required": ["results", "totalVotes"], "properties": { "results": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 10000 } }, "totalVotes": { "type": "integer", "minimum": 1, "maximum": 10000 } } },
    "hex": { "type": "string", "pattern": "^(0|[1-9a-f][0-9a-f]*)$" },
    "orProof": {
      "type": "object", "additionalProperties": false, "required": ["a1s", "a2s", "es", "zs"],
      "properties": { "a1s": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/hex" } }, "a2s": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/hex" } }, "es": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/hex" } }, "zs": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/hex" } } }
    },
    "sumProof": { "type": "object", "additionalProperties": false, "required": ["a1", "a2", "e", "z"], "properties": { "a1": { "$ref": "#/$defs/hex" }, "a2": { "$ref": "#/$defs/hex" }, "e": { "$ref": "#/$defs/hex" }, "z": { "$ref": "#/$defs/hex" } } },
    "vectorBallot": { "type": "object", "additionalProperties": false, "required": ["nullifierHash", "preparedBallotID", "candidateCommitment", "ciphertextVector", "validityProof"], "properties": { "nullifierHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "preparedBallotID": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "candidateCommitment": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "ciphertextVector": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "election-bundle-v1.schema.json#/$defs/ciphertext" } }, "validityProof": { "$ref": "#/$defs/vectorProof" } } },
    "vectorProof": { "type": "object", "additionalProperties": false, "required": ["bitProofs", "sumProof"], "properties": { "bitProofs": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/orProof" } }, "sumProof": { "$ref": "#/$defs/sumProof" } } },
    "vectorReceipt": { "type": "object", "additionalProperties": false, "required": ["schema", "ballotID", "electionID", "artifactHash", "status", "createdAt", "createdTxID", "terminalAt", "terminalTxID"], "properties": { "schema": { "const": "mongbas-vector-ballot-receipt/v1" }, "ballotID": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "electionID": { "type": "string", "minLength": 1 }, "artifactHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "status": { "enum": ["cast", "audited"] }, "createdAt": { "type": "integer", "minimum": 0 }, "createdTxID": { "type": "string", "minLength": 1 }, "terminalAt": { "type": "integer", "minimum": 0 }, "terminalTxID": { "type": "string", "minLength": 1 } } },
    "vectorDisclosure": { "type": "object", "additionalProperties": false, "required": ["schema", "ballotID", "electionID", "artifactHash", "selectedIndex", "clientNonce", "randomness", "encryptedCandidateVector", "vectorBallotValidityProof", "status", "auditedAt", "auditedTxID"], "properties": { "schema": { "const": "mongbas-vector-audit-disclosure/v1" }, "ballotID": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "electionID": { "type": "string", "minLength": 1 }, "artifactHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "selectedIndex": { "type": "integer", "minimum": 0 }, "clientNonce": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "randomness": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/hex" } }, "encryptedCandidateVector": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "election-bundle-v1.schema.json#/$defs/ciphertext" } }, "vectorBallotValidityProof": { "$ref": "#/$defs/vectorProof" }, "status": { "const": "audited" }, "auditedAt": { "type": "integer", "minimum": 0 }, "auditedTxID": { "type": "string", "minLength": 1 } } },
    "vectorPartial": { "type": "object", "additionalProperties": false, "required": ["index", "mspID", "publicKeyY", "values", "proofs"], "properties": { "index": { "type": "integer", "minimum": 1, "maximum": 3 }, "mspID": { "type": "string", "minLength": 1 }, "publicKeyY": { "$ref": "#/$defs/hex" }, "values": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/hex" } }, "proofs": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "election-bundle-v2.schema.json#/$defs/proof" } } } }
  }
}
