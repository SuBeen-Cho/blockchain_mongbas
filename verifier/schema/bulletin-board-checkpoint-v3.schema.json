{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mongbas.example/schema/bulletin-board-checkpoint-v3.schema.json",
  "title": "Mongbas Cast-Event History Witness Checkpoint v3",
  "oneOf": [
    { "$ref": "#/$defs/opening" },
    { "$ref": "#/$defs/observation" }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "common": {
      "type": "object",
      "properties": {
        "schema": { "const": "mongbas-bulletin-board-checkpoint/v3" },
        "witnessID": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
        "witnessPublicKeyDer": { "type": "string", "contentEncoding": "base64" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "previousCheckpointHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] },
        "observedAt": { "type": "string", "format": "date-time" },
        "electionID": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,256}$" },
        "electionContextHash": { "$ref": "#/$defs/hash" },
        "epochSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "history": { "$ref": "#/$defs/history" },
        "signature": { "type": "string", "contentEncoding": "base64" }
      },
      "required": ["schema", "kind", "witnessID", "witnessPublicKeyDer", "sequence", "previousCheckpointHash",
        "observedAt", "electionID", "electionContextHash", "epochSeconds", "history", "signature"]
    },
    "opening": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        { "type": "object", "additionalProperties": false,
          "properties": {
            "schema": true, "witnessID": true, "witnessPublicKeyDer": true, "sequence": { "const": 1 },
            "previousCheckpointHash": { "type": "null" }, "observedAt": true, "electionID": true,
            "electionContextHash": true, "epochSeconds": true, "signature": true,
            "kind": { "const": "opening" }, "history": { "$ref": "#/$defs/openingHistory" }
          }
        }
      ]
    },
    "observation": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        { "type": "object", "additionalProperties": false,
          "required": ["historyArtifactHash", "bundleHash", "bulletinBoardRoot", "ballotCount", "publishedAt"],
          "properties": {
            "schema": true, "witnessID": true, "witnessPublicKeyDer": true, "sequence": true,
            "previousCheckpointHash": { "$ref": "#/$defs/hash" }, "observedAt": true, "electionID": true,
            "electionContextHash": true, "epochSeconds": true, "history": true, "signature": true,
            "kind": { "const": "observation" }, "historyArtifactHash": { "$ref": "#/$defs/hash" },
            "bundleHash": { "$ref": "#/$defs/hash" }, "bulletinBoardRoot": { "$ref": "#/$defs/hash" },
            "ballotCount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
            "publishedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        }
      ]
    },
    "history": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "treeAlgorithm", "leafAlgorithm", "treeSize", "rootHash", "previousTreeSize", "previousRootHash", "consistencyPath"],
      "properties": {
        "schema": { "const": "mongbas-cast-event-history/v1" },
        "treeAlgorithm": { "const": "mongbas-cast-event-history-tree-sha256/v1" },
        "leafAlgorithm": { "const": "mongbas-cast-event-id-sha256/v1" },
        "treeSize": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "rootHash": { "$ref": "#/$defs/hash" },
        "previousTreeSize": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "previousRootHash": { "$ref": "#/$defs/hash" },
        "consistencyPath": { "type": "array", "maxItems": 54, "items": { "$ref": "#/$defs/hash" } }
      }
    },
    "openingHistory": {
      "allOf": [
        { "$ref": "#/$defs/history" },
        { "properties": { "treeSize": { "const": 0 }, "previousTreeSize": { "const": 0 },
          "consistencyPath": { "maxItems": 0 } } }
      ]
    }
  }
}
