{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mongbas.example/schema/election-bundle-v2.schema.json",
  "title": "Mongbas Threshold Election Bundle v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "algorithms", "configuration", "provenance", "publicKey", "trusteePublicShares", "ballots", "bulletinBoard", "aggregateCiphertext", "tally", "partialDecryptions", "signatures"],
  "properties": {
    "schema": { "const": "mongbas-election-bundle/v2" },
    "algorithms": {
      "type": "object", "additionalProperties": false,
      "required": ["canonicalization", "hash", "signature", "tally"],
      "properties": {
        "canonicalization": { "const": "mongbas-canonical-json-v1" },
        "hash": { "const": "sha-256" },
        "signature": { "const": "ed25519" },
        "tally": { "const": "mongbas-exp-elgamal-threshold-v2" }
      }
    },
    "configuration": { "$ref": "election-bundle-v1.schema.json#/properties/configuration" },
    "provenance": { "$ref": "election-bundle-v1.schema.json#/properties/provenance" },
    "publicKey": { "$ref": "election-bundle-v1.schema.json#/$defs/publicKey" },
    "trusteePublicShares": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/publicShare" } },
    "ballots": { "type": "array", "minItems": 1, "items": { "$ref": "election-bundle-v1.schema.json#/$defs/ballot" } },
    "bulletinBoard": { "$ref": "election-bundle-v1.schema.json#/properties/bulletinBoard" },
    "aggregateCiphertext": { "$ref": "election-bundle-v1.schema.json#/$defs/ciphertext" },
    "tally": { "$ref": "election-bundle-v1.schema.json#/properties/tally" },
    "partialDecryptions": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "#/$defs/partialDecryption" } },
    "signatures": { "$ref": "election-bundle-v1.schema.json#/properties/signatures" }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^(0|[1-9a-f][0-9a-f]*)$" },
    "publicShare": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "mspID", "publicKeyY"],
      "properties": {
        "index": { "type": "integer", "minimum": 1, "maximum": 3 },
        "mspID": { "type": "string", "minLength": 1 },
        "publicKeyY": { "$ref": "#/$defs/hex" }
      }
    },
    "proof": {
      "type": "object", "additionalProperties": true,
      "required": ["c1", "c2", "a1", "a2", "e", "z"],
      "properties": {
        "c1": { "$ref": "#/$defs/hex" }, "c2": { "$ref": "#/$defs/hex" },
        "a1": { "$ref": "#/$defs/hex" }, "a2": { "$ref": "#/$defs/hex" },
        "e": { "$ref": "#/$defs/hex" }, "z": { "$ref": "#/$defs/hex" }
      }
    },
    "partialDecryption": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "mspID", "publicKeyY", "value", "proof"],
      "properties": {
        "index": { "type": "integer", "minimum": 1, "maximum": 3 },
        "mspID": { "type": "string", "minLength": 1 },
        "publicKeyY": { "$ref": "#/$defs/hex" },
        "value": { "$ref": "#/$defs/hex" },
        "proof": { "$ref": "#/$defs/proof" }
      }
    }
  }
}
