{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mongbas.example/schema/complaint-monitor-trust-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "monitors"],
  "properties": {
    "schema": { "const": "mongbas-complaint-monitor-trust/v1" },
    "monitors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ed25519PublicKeyDer"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
          "ed25519PublicKeyDer": { "type": "string" }
        }
      }
    }
  }
}
