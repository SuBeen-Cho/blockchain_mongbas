{
  "name": "voting-backend",
  "version": "1.0.0",
  "description": "다조직 합의 익명 전자투표 블록체인 REST API 서버",
  "main": "src/app.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "keys:ed25519": "node scripts/generate-ed25519-env.js",
    "keys:ps-bbs": "node scripts/generate-ps-bbs-env.js",
    "e2e:ed25519": "node scripts/ed25519-e2e-smoke.js",
    "e2e:revocation": "node scripts/credential-revocation-e2e.js",
    "e2e:audit-state": "node scripts/cast-intent-audit-e2e.js",
    "e2e:vector-aoc": "node scripts/vector-audit-or-cast-e2e.js",
    "e2e:merkle": "node scripts/merkle-e2e-smoke.js",
    "e2e:full": "node scripts/full-election-e2e.js",
    "bench:elgamal": "node benchmark/elgamal-e2e-bench.js",
    "bench:elgamal:conc": "node benchmark/elgamal-concurrency-bench.js",
    "bench:elgamal:rate": "node benchmark/elgamal-rate-bench.js",
    "bench:elgamal:run": "bash benchmark/run-elgamal-bench.sh"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@hyperledger/fabric-gateway": "^1.4.0",
    "@mattrglobal/bbs-signatures": "^2.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.0",
    "express-rate-limit": "^8.5.1",
    "puppeteer-core": "^25.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
