# ══════════════════════════════════════════════════════
# 다조직 합의 기반 암호화·검증형 전자투표 API — 환경변수 설정
# ══════════════════════════════════════════════════════
# 이 파일을 .env로 복사하여 사용하세요.
# 운영 환경에서는 NODE_ENV=production 필수.

# ── 서버 설정 ──────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── 관리자 API (운영 필수) ──────────────────────────────────────
# ADMIN_API_TOKEN=<최소 32바이트 랜덤 문자열>
# 개발 중 인증 없이 관리 API를 쓰는 명시적 예외(운영 금지):
# ALLOW_INSECURE_ADMIN_API=false
# ENABLE_DEMO_ENDPOINTS=false  # seed-votes 등 발표용 기능을 명시적으로 활성화
# REQUIRE_DEMO_ADMISSION=false # QR 시연 시 true: 예측 가능한 demo 계정의 직접 발급 차단
# ENABLE_BENCH_ENDPOINTS=false # 인증 microbenchmark endpoint (운영 금지)
# DISABLE_RATE_LIMITS=false    # 격리 성능평가 backend 전용 (운영 금지)

# ── CORS ─────────────────────────────────────────────
# 쉼표 구분으로 허용 origin 지정 (기본: localhost)
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# reverse proxy가 하나일 때만 1. 직접 접속은 0. 요청 헤더 값을 그대로 신뢰하지 않음.
TRUST_PROXY_HOPS=0
# TLS reverse proxy를 통해서만 서비스할 때 활성화. production은 자동 활성화.
# ENABLE_HSTS=false

# ── Credential 인증 모드 ──────────────────────────────
IDEMIX_ENABLED=true
ASYM_CRED_ENABLED=true
# IDEMIX_IMPL=         # 'ps' | 'bbs' | '' (Ed25519)

# ── Credential 설정 ──────────────────────────────────
# CREDENTIAL_SECRET=<최소 32바이트 랜덤 문자열>  (운영 필수)
CREDENTIAL_TTL_SEC=600
ENABLE_DEMO_CREDENTIALS=false
# VOTER_REGISTRY_FILE=/secure/path/voter-registry.json

# ── Ed25519 키 (npm run keys:ed25519 로 생성) ────────
# ED25519_PRIVATE_KEY_DER_B64=<base64 DER private key>
# ED25519_PUBLIC_KEY_DER_B64=<base64 DER public key>

# ── PS-BN254 Idemix 키 (npm run keys:ps-bbs 로 생성) ──
# PS_ISSUER_SEED=<임의 문자열 — 고정해야 재시작 후에도 키 유지>
# (공개키 PS_ISSUER_PUBLIC_KEY_B64 는 chaincode 컨테이너에 주입)

# ── BBS+-BLS12381 Idemix 키 (npm run keys:ps-bbs 로 생성) ──
# BBS_ISSUER_SEED=<임의 문자열 — 고정해야 재시작 후에도 키 유지>
# (공개키 BBS_PUBLIC_KEY_B64 는 chaincode 컨테이너에 주입)

# ── Panic Mode ────────────────────────────────────────
# PANIC_PASSWORD=<패닉 모드 비밀번호>

# ── 감사 로그 ─────────────────────────────────────────
CREDENTIAL_AUDIT_ENABLED=true
# CREDENTIAL_AUDIT_PATH=audit-logs/credential-issuance.jsonl
# AUDIT_HMAC_KEY=<최소 32바이트; 미설정 시 CREDENTIAL_SECRET 사용>
# LISTEN_HOST=127.0.0.1 # Tailscale Serve reverse proxy profile; Docker/LAN deployments may require 0.0.0.0
# ENABLE_HSTS=true # HTTPS-only deployment profile
# TRUST_PROXY_HOPS=1 # only when the application is reachable solely through one trusted local reverse proxy

# ── Bypass credential (개발 전용) ─────────────────────
# ALLOW_BYPASS_CREDENTIAL=true  # 운영 환경에서는 절대 true 금지

# ── 독립 election bundle 공개 설정 ──────────────────────
# 아래에는 공개키만 입력합니다. 기관 private key는 API/.env/Git에 두지 마세요.
# BUNDLE_ORGANIZATIONS_JSON=[{"id":"ec","ed25519PublicKeyDer":"<base64-spki>"},{"id":"civil","ed25519PublicKeyDer":"<base64-spki>"}]
# BUNDLE_SIGNATURE_THRESHOLD=2
# MONGBAS_GIT_COMMIT=<40-char-lowercase-git-commit>
# MONGBAS_IMAGE_DIGEST=sha256:<64-char-lowercase-image-digest>
# MONGBAS_SOFTWARE_VERSION=0.1.0
