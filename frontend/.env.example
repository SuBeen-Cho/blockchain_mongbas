# Optional origin encoded into the QR code when admin and voter hostnames differ.
# Leave empty to use the dashboard's current origin (recommended for Tailscale tests).
VITE_PUBLIC_VOTER_ORIGIN=

# Optional external showcase relay. Disabled by default because it discloses the
# election URL and ID to that service. Use only after an explicit privacy review.
VITE_KIOSK_RELAY_URL=
